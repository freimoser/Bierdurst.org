---
interface Point { year: number; value: number }
const { series, unit = '', title } = Astro.props as { series: Point[]; unit?: string; title: string };
const values = series.map((point) => point.value);
const max = Math.max(...values);
const format = (value: number) => unit === 'Mio. hl'
  ? value.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })
  : value.toLocaleString('de-DE');
// Jede Grafik braucht eine eigene ID, sonst kollidieren mehrere Diagramme auf einer Seite.
const chartId = `chart-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
// Balkenhoehe proportional zum Wert, Nulllinie bei null. Eine Grundhoehe plus
// skalierte Spanne (frueher 28 % + 72 %) laesst kleine Unterschiede dramatisch
// aussehen: ein Rueckgang von 19 % erschien als Rueckgang von 72 %.
const barHeight = (value: number) => (value / max) * 100;
---
<figure class="stat-chart" aria-labelledby={`${chartId}-title`}>
  <figcaption id={`${chartId}-title`}>{title}</figcaption>
  <div class="chart-plot" role="img" aria-label={`${title}: ${series.map((point) => `${point.year} ${format(point.value)} ${unit}`).join(', ')}`}>
    {series.map((point, index) => {
      const height = barHeight(point.value);
      return <div class="chart-column">
        <span class="chart-value">{format(point.value)}</span>
        <span class="chart-bar" style={`--bar-height:${height}%`}><i></i></span>
        <span class="chart-year">{point.year}</span>
        {index < series.length - 1 && <span class="chart-change" aria-hidden="true"></span>}
      </div>;
    })}
  </div>
  {unit && <p class="chart-unit">Einheit: {unit}. Die Balken beginnen bei null und sind damit maßstabsgetreu.</p>}
  <details class="chart-data">
    <summary>Zahlen als Tabelle</summary>
    <table>
      <caption>{title}{unit ? ` (${unit})` : ''}</caption>
      <thead><tr><th scope="col">Jahr</th><th scope="col">Wert{unit ? ` in ${unit}` : ''}</th></tr></thead>
      <tbody>
        {series.map((point) => <tr><th scope="row">{point.year}</th><td>{format(point.value)}</td></tr>)}
      </tbody>
    </table>
  </details>
</figure>
