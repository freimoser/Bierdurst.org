---
const { sources = [], edited } = Astro.props as { sources?: string[]; edited?: string };

// Herausgebername je Host. Ein aus dem URL-Pfad abgeleitetes Label macht aus
// einer Destatis-Pressemitteilung "PD26 037 73.html" und nennt den Herausgeber
// gar nicht -- fuer eine Seite, die mit belegten Zahlen wirbt, zu wenig.
const publishers: Record<string, string> = {
  'destatis.de': 'Statistisches Bundesamt (Destatis)',
  'genesis.destatis.de': 'Statistisches Bundesamt, GENESIS-Datenbank',
  'brauer-bund.de': 'Deutscher Brauer-Bund',
  'gesetze-im-internet.de': 'Bundesamt für Justiz, Gesetze im Internet',
  'muenchen.de': 'Landeshauptstadt München',
  'oktoberfest.de': 'oktoberfest.de',
  'lebensmittelklarheit.de': 'Lebensmittelklarheit, Verbraucherzentrale',
  'de.statista.com': 'Statista',
  'barthhaas.com': 'BarthHaas',
  'paulaner.de': 'Paulaner Brauerei',
  'paulaner.com': 'Paulaner Brauerei',
  'krombacher.de': 'Krombacher Brauerei',
  'bitburger.com': 'Bitburger Braugruppe',
  'weihenstephaner.de': 'Staatsbrauerei Weihenstephan',
  'weltenburger.de': 'Klosterbrauerei Weltenburg',
  'bolten-brauerei.de': 'Bolten Brauerei',
  'augustiner-braeu.de': 'Augustiner-Bräu München',
  'coronadobrewing.com': 'Coronado Brewing Company',
  // Stilrichtlinien. Sie tragen die Zahlen der Steckbrief-Tabellen:
  // Alkohol, Bittereinheiten, Farbe und Stammwuerze. Die Seite des
  // Brauer-Bunds, die daneben steht, beschreibt nur das Aromaprofil.
  'styles.bjcp.org': 'Beer Judge Certification Program (BJCP)',
  'brewersassociation.org': 'Brewers Association'
};

// Hersteller- und Verbandsangaben sind Primaerquellen in eigener Sache und
// werden als solche gekennzeichnet.
const interested = new Set([
  'paulaner.de', 'paulaner.com', 'krombacher.de', 'bitburger.com', 'weihenstephaner.de',
  'weltenburger.de', 'bolten-brauerei.de', 'augustiner-braeu.de', 'coronadobrewing.com',
  'brauer-bund.de', 'oktoberfest.de'
]);

// Dokumenttitel je Quelle, von Hand gepflegt. Aus einem URL-Slug laesst sich
// deutsche Gross- und Kleinschreibung nicht rekonstruieren: Die Ableitung
// machte aus "bierstile-in-deutschland" ein "Bierstile in deutschland" und aus
// einer Pressemitteilung "Deutscher brauer bund zieht bilanz zum tag des
// deutschen bieres". Steht eine Quelle nicht in der Liste, nennen wir nur den
// Herausgeber -- lieber knapp als falsch geschrieben.
const documents: Record<string, string> = {
  'brauer-bund.de/biervielfalt/bierstile-in-deutschland': 'Bierstile in Deutschland',
  'brauer-bund.de/biervielfalt/bierstile-in-deutschland/bierregionen': 'Bierregionen in Deutschland',
  'brauer-bund.de/genuss/food-pairing': 'Food-Pairing: Bier und Essen',
  'brauer-bund.de/reinheitsgebot/fragen-und-antworten': 'Reinheitsgebot: Fragen und Antworten',
  'brauer-bund.de/pressemitteilungen/deutscher-brauer-bund-zieht-bilanz-zum-tag-des-deutschen-bieres': 'Bilanz zum Tag des Deutschen Bieres',
  'brauer-bund.de/pressemitteilungen/alkoholfreie-biere-klettern-auf-10-prozent': 'Alkoholfreie Biere klettern auf 10 Prozent',
  'gesetze-im-internet.de/bierv': 'Bierverordnung',
  'genesis.destatis.de/datenbank/online/statistic/73421/table/73421-0001': 'Tabelle 73421-0001, Biersteuerstatistik',
  'destatis.de/DE/Themen/Wirtschaft/Preise/Verbraucherpreisindex/Tabellen/Verbraucherpreise-12Kategorien.html': 'Verbraucherpreisindex nach Kategorien',
  'lebensmittelklarheit.de/fragen-antworten/warum-darf-bier-mit-alkohol-als-alkoholfrei-bezeichnet-werden': 'Warum darf Bier mit Alkohol als alkoholfrei bezeichnet werden?',
  'oktoberfest.de/magazin/essen-und-trinken/die-sechs-muenchner-brauereien-auf-der-wiesn': 'Die sechs Münchner Brauereien auf der Wiesn',
  'oktoberfest.de/bierzelte': 'Bierzelte',
  'oktoberfest.de/bierzelte/grosse-zelte': 'Große Zelte',
  'oktoberfest.de/bierzelte/reservieren/reservieren-auf-dem-oktoberfest': 'Reservieren auf dem Oktoberfest',
  'oktoberfest.de/informationen/bierpreis': 'Bierpreise',
  'oktoberfest.de/informationen/termine': 'Termine',
  'oktoberfest.de/informationen/die-oeffnungszeiten-des-oktoberfests': 'Öffnungszeiten des Oktoberfests',
  'oktoberfest.de/gelaendeplan': 'Geländeplan',
  'muenchen.de/veranstaltungen/oktoberfest': 'Oktoberfest',
  'coronadobrewing.com/blogs/news/beer-cooling-times-fridge-vs-freezer': 'Beer Cooling Times: Fridge vs. Freezer',
  'bitburger.com/beers/premium-classics/premium-pils': 'Premium Pils',
  'paulaner.de/produkte/hellbiere/muenchner-hell': 'Münchner Hell',
  'paulaner.de/produkte/hellbiere/muenchner-hell-alkoholfrei': 'Münchner Hell Alkoholfrei',
  'paulaner.de/produkte/hellbiere/natur-radler': 'Natur Radler',
  'paulaner.de/produkte/weissbiere/hefe-weissbier-naturtrueb': 'Hefe-Weißbier Naturtrüb',
  'paulaner.com/our-products/oktoberfest-bier': 'Oktoberfest Bier'
};

const describe = (source: string) => {
  try {
    const url = new URL(source);
    const host = url.hostname.replace(/^www\./, '');
    const publisher = publishers[host] ?? host;
    const key = `${host}${url.pathname.replace(/\/+$/, '')}`;
    const document = documents[key] ?? '';
    return { publisher, document, host, selfInterested: interested.has(host) };
  } catch {
    return { publisher: source, document: '', host: '', selfInterested: false };
  }
};

const uniqueSources = [...new Set(sources)];
---
{uniqueSources.length > 0 && (
  <section class="sources" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Quellen und Einordnung</h2>
    <p>
      Die Inhalte stützen sich auf die folgenden Ausgangsquellen.
      {/* Nicht "redaktionell geprueft": Eine Durchsicht ist nirgends erfasst,
          und eine neue Abbildung ist keine. Genannt wird nur, was die
          Git-Historie des Textes belegt. */}
      {edited ? ` Zuletzt am Text gearbeitet: ${edited}.` : ''}
    </p>
    <ul>
      {uniqueSources.map((source) => {
        const { publisher, document, selfInterested } = describe(source);
        return (
          <li>
            <a href={source} rel="noopener noreferrer"><strong>{publisher}</strong>{document ? `: ${document}` : ''}</a>
            {selfInterested && <span class="source-note"> — Angabe des Herausgebers in eigener Sache</span>}
          </li>
        );
      })}
    </ul>
  </section>
)}
