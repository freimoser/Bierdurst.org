---
const { position = 'article' } = Astro.props;
const publisherId = import.meta.env.PUBLIC_ADSENSE_PUBLISHER_ID ?? '';
const cmpUrl = import.meta.env.PUBLIC_CMP_SCRIPT_URL ?? '';
const adsConfigured = /^ca-pub-\d{16}$/.test(publisherId) && /^https:\/\//.test(cmpUrl);
---
{adsConfigured && (
  <aside class="ad-slot" data-ad-slot={position} aria-label="Werbefläche"></aside>
)}
