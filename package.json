{
  "name": "bierdurst-org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/generate-og-images.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/prepare-dist.mjs && node scripts/validate-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && node scripts/test-calculators.mjs && node scripts/test-beer-data.mjs",
    "test": "node scripts/test-calculators.mjs && node scripts/test-beer-data.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
